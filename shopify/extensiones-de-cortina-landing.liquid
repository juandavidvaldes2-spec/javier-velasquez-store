<script>
(function(){
  var root = document.currentScript.closest('.jv-store') || document.querySelector('.jv-store');
  if (!root) return;
  root.classList.add('anim-on');

  var imgs = root.querySelectorAll('img');
  for (var i = 0; i < imgs.length; i++) {
    (function(img){
      img.classList.add('lz');
      if (img.complete && img.naturalWidth > 0) { img.classList.add('loaded'); }
      else {
        img.addEventListener('load', function(){ img.classList.add('loaded'); });
        img.addEventListener('error', function(){ img.classList.add('loaded'); });
      }
    })(imgs[i]);
  }

  var secs = root.querySelectorAll('section');
  if ('IntersectionObserver' in window) {
    for (var j = 0; j < secs.length; j++) secs[j].classList.add('reveal');
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });
    for (var k = 0; k < secs.length; k++) io.observe(secs[k]);
  }

  // Selector de tono. Cambia foto, nombre, precio y la variante que va al carrito.
  var tonos = window.TONOS || {};
  var vars = window.JV_VARIANTES || {};
  var btns = root.querySelectorAll('[data-tono]');
  var bImg = root.querySelector('#buy-img');
  var bName = root.querySelector('#buy-name');
  var bPr = root.querySelector('#buy-pr');
  var bId = root.querySelector('.jv-buy input[name="id"]');
  var bBtn = root.querySelector('.jv-buy button');
  function elegir(key){
    var t = tonos[key]; if (!t) return;
    for (var b = 0; b < btns.length; b++) {
      var on = btns[b].getAttribute('data-tono') === key;
      btns[b].classList.toggle('sel', on);
      btns[b].setAttribute('aria-pressed', on ? 'true' : 'false');
    }
    if (bImg) { bImg.src = t.img; bImg.alt = t.alt; }
    if (bName) bName.textContent = t.n;
    if (bPr) bPr.textContent = t.p;
    var v = vars[t.n];
    if (bId && v) bId.value = v.id;
    if (bBtn) {
      var ok = !!(v && v.ok);
      bBtn.disabled = !ok;
      bBtn.style.opacity = ok ? '' : '.45';
      bBtn.innerHTML = ok ? 'Comprar Ahora <span>&rarr;</span>' : 'Agotado';
    }
  }
  for (var m = 0; m < btns.length; m++) {
    btns[m].addEventListener('click', function(){ elegir(this.getAttribute('data-tono')); });
  }
  if (window.TONO_INICIAL) elegir(window.TONO_INICIAL);
})();
</script>

