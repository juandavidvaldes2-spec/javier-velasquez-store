{% comment %}
  Home de la tienda -- Javier Velasquez Store (seccion para Shopify)
  Subir este archivo a: theme/sections/jv-store-home.liquid
  Las imagenes van en Content > Files (ver lista en LEEME-shopify.md).
  Los enlaces se configuran en Personalizar tema, sin tocar codigo.
{% endcomment %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&display=swap');
.jv-store *{margin:0;padding:0;box-sizing:border-box;font-family:inherit;font-weight:inherit;font-style:inherit;color:inherit;letter-spacing:inherit;line-height:inherit;text-transform:none;text-decoration:none;list-style:none;background:transparent;vertical-align:baseline;border:0}
.jv-store{
    --bg:#ffffff; --ink:#141414; --soft:#555; --mute:#8f8f8f; --line:#ececec; --black:#0a0a0a;
    --warm:#b39a78; --warm-bg:#f3ede3; --warm-line:#e4d8c6;
  }
.jv-store{scroll-behavior:smooth}
.jv-store{font-family:'Inter',-apple-system,sans-serif;background:var(--bg);color:var(--ink);line-height:1.5;-webkit-font-smoothing:antialiased;font-size:15px;overflow-x:hidden}
.jv-store a{color:inherit;text-decoration:none}
.jv-store img{display:block;max-width:100%}
.jv-store .btn{display:inline-flex;align-items:center;gap:10px;background:var(--black);color:#fff;padding:13px 26px;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;transition:all .2s}
.jv-store .btn:hover{background:#2a2a2a;transform:translateX(3px)}
.jv-store .btn.warm{background:var(--warm)}
.jv-store .btn.warm:hover{background:#9c8464}
.jv-store header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
.jv-store .head-in{max-width:1360px;margin:0 auto;padding:18px 40px;display:flex;align-items:center;justify-content:space-between}
.jv-store .logo{display:flex;flex-direction:column;align-items:center;line-height:1}
.jv-store .logo .n{font-weight:400;font-size:22px;letter-spacing:.16em;padding-left:.16em}
.jv-store .logo .s{font-weight:600;font-size:10px;letter-spacing:.34em;padding-left:.34em;text-transform:uppercase;color:var(--soft);margin-top:6px}
.jv-store nav{display:flex;gap:30px;font-size:12px}
.jv-store .cart-pill{display:inline-flex;align-items:center;gap:8px;font-size:10px;letter-spacing:1.6px;text-transform:uppercase;font-weight:600;border:1px solid var(--line);border-radius:100px;padding:8px 14px;white-space:nowrap;transition:background .2s}
.jv-store .cart-pill:hover{background:#f7f7f5}
.jv-store .cart-pill b{background:var(--black);color:#fff;border-radius:100px;min-width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;font-size:10px}
.jv-store nav a:hover{opacity:.5}
.jv-store .hero{max-width:1360px;margin:0 auto;padding:42px 40px 34px;text-align:center}
.jv-store .hero .eye{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--mute);font-weight:500;margin-bottom:16px}
.jv-store .hero h1{font-weight:200;font-size:clamp(2.2rem,4.2vw,3.5rem);letter-spacing:-.02em;line-height:1.05;margin-bottom:18px}
.jv-store .hero h1 b{font-weight:500}
.jv-store .hero p{color:var(--soft);font-size:1.02rem;max-width:520px;margin:0 auto;font-weight:300}
.jv-store .products{max-width:1200px;margin:0 auto;padding:6px 40px 60px}
.jv-store .pgrid{display:grid;grid-template-columns:1fr 1fr;gap:28px}
.jv-store .pcard{border:1px solid var(--line);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;background:#fff;transition:box-shadow .25s ease,transform .25s ease}
.jv-store .pcard:hover{box-shadow:0 16px 44px rgba(0,0,0,.09);transform:translateY(-4px)}
.jv-store .pcard.warm{background:var(--warm-bg);border-color:var(--warm-line)}
.jv-store .pcard-media{height:250px;display:flex;align-items:center;justify-content:center;padding:22px;background:#f7f7f5}
.jv-store .pcard.warm .pcard-media{background:#efe6d6}
.jv-store .pcard-media img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}
.jv-store .pcard-body{padding:26px 32px 30px;display:flex;flex-direction:column;flex:1}
.jv-store .p-eye{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--mute);font-weight:600;margin-bottom:12px}
.jv-store .pcard-body h3{font-weight:300;font-size:1.8rem;letter-spacing:-.01em;line-height:1.05;margin-bottom:4px}
.jv-store .by{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--mute);margin-bottom:16px}
.jv-store .pcard-body p{color:var(--soft);font-size:.96rem;font-weight:300;margin-bottom:20px;line-height:1.6}
.jv-store .p-feats{display:flex;gap:10px;margin-bottom:24px;flex-wrap:wrap}
.jv-store .p-feats span{font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:var(--soft);font-weight:500;border:1px solid var(--line);border-radius:100px;padding:6px 12px}
.jv-store .pcard.warm .p-feats span{border-color:var(--warm-line)}
.jv-store .pcard-body .btn{align-self:flex-start;margin-top:auto}
.jv-store .creator{background:#0a0a0a;color:#fff;display:grid;grid-template-columns:1fr 1.2fr;align-items:stretch;height:400px}
.jv-store .creator .c-photo{overflow:hidden}
.jv-store .creator .c-photo img{width:100%;height:100%;object-fit:cover;object-position:center 22%}
.jv-store .creator .c-text{padding:0 70px;display:flex;flex-direction:column;justify-content:center}
.jv-store .creator .c-eye{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#8f8f8f;font-weight:600;margin-bottom:18px}
.jv-store .creator .c-text h2{font-weight:300;font-size:clamp(1.6rem,2.6vw,2.3rem);line-height:1.2;margin-bottom:20px}
.jv-store .creator .c-text h2 b{font-weight:500}
.jv-store .creator .c-text p{color:#c7c7c7;font-size:.98rem;font-weight:300;line-height:1.7;max-width:460px;margin-bottom:14px}
.jv-store.anim-on section.reveal{opacity:0;transform:translateY(26px);transition:opacity .85s cubic-bezier(.22,1,.36,1),transform .85s cubic-bezier(.22,1,.36,1)}
.jv-store.anim-on section.reveal.in{opacity:1;transform:none}
.jv-store.anim-on img.lz{opacity:0;transition:opacity .7s ease}
.jv-store.anim-on img.lz.loaded{opacity:1}
@media (prefers-reduced-motion:reduce){
.jv-store.anim-on section.reveal, .jv-store.anim-on img.lz{opacity:1!important;transform:none!important;transition:none!important}
}
.jv-store footer{background:#0a0a0a;color:#fff;border-top:1px solid rgba(255,255,255,.1);padding:40px 40px}
.jv-store .foot-in{max-width:1360px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px}
.jv-store .foot-in .fl .n{font-size:18px;letter-spacing:.14em}
.jv-store .foot-in .fl .s{font-size:9px;letter-spacing:.3em;color:#8f8f8f;text-transform:uppercase;margin-top:4px}
.jv-store .foot-in .fr{font-size:11px;color:#8f8f8f}
@media(max-width:900px){
.jv-store .head-in{padding:14px 20px;justify-content:center;gap:16px}
.jv-store nav{display:none}
.jv-store .cart-pill{padding:7px 12px}
.jv-store .hero{padding:44px 22px 34px}
.jv-store .products{padding:6px 20px 44px}
.jv-store .pgrid{grid-template-columns:1fr;gap:22px}
.jv-store .pcard-media{height:230px}
.jv-store .pcard-body{padding:24px 26px 28px}
.jv-store .creator{grid-template-columns:1fr;height:auto}
.jv-store .creator .c-photo{height:340px}
.jv-store .creator .c-text{padding:44px 24px}
.jv-store .foot-in{flex-direction:column;text-align:center}
}
</style>

<div class="jv-store">
<header>
  <div class="head-in">
    <a href="{{ section.settings.home_url }}" class="logo"><span class="n">JAVIER VELÁSQUEZ</span><span class="s">Store</span></a>
    <nav>
      <a href="#productos">Productos</a>
      <a href="{{ section.settings.plasmaflow_url }}">PLASMAFLOW</a>
      <a href="{{ section.settings.plancha_url }}">Plancha Rizadora</a>
      <a href="#javier">Sobre Javier</a>
    </nav>
    {%- if cart.item_count > 0 -%}
      <a href="/cart" class="cart-pill">Carrito <b>{{ cart.item_count }}</b></a>
    {%- endif -%}
  </div>
</header>

<section class="hero">
  <div class="eye">Javier Velásquez Store</div>
  <h1>Herramientas <b>profesionales</b><br>para tu cabello</h1>
  <p>Cada herramienta de la tienda está seleccionada y respaldada por Javier Velásquez, para lograr resultados de salón desde casa.</p>
</section>

<section id="productos" class="products">
  <div class="pgrid">

    <article class="pcard">
      {%- comment -%}
        Foto de producto sobre negro, elegida por Juan el 11-ago. Antes estaba el
        diagrama con las etiquetas en inglés (Cool Tip, Ceramic Barrel), que no
        pinta nada en la portada de una tienda en español. La caja va en negro
        para que empalme con el fondo de la foto y se vea una sola pieza.
      {%- endcomment -%}
      <div class="pcard-media" style="background:#0a0a0a"><img src="{{ 'plasmaflow-card-negro.jpg' | file_url }}" alt="PLASMAFLOW, cepillo con tecnología de plasma e infrarrojo"></div>
      <div class="pcard-body">
        <div class="p-eye">Anti-Frizz Brush</div>
        <h3>PLASMAFLOW</h3>
        <div class="by">by Javier Velásquez</div>
        <p>El cepillo de retoque que controla el frizz, da brillo y logra un acabado tipo blowout en 10 a 15 minutos.</p>
        <div class="p-feats"><span>Plasma</span><span>Infrarrojo</span><span>Cerámica</span><span>Iones</span></div>
        <a href="{{ section.settings.plasmaflow_url }}" class="btn">Ver PLASMAFLOW <span>&rarr;</span></a>
      </div>
    </article>

    <article class="pcard">
      {%- comment -%}
        Sin recorte. Antes esta tarjeta tenía puesto a mano un object-fit:cover
        que llenaba la caja cortando la plancha por los lados. Ahora se comporta
        igual que la de PlasmaFlow: la pieza se ve entera, centrada y respirando.
      {%- endcomment -%}
      <div class="pcard-media"><img src="{{ 'producto-limpio-card.jpg' | file_url }}" alt="Plancha Rizadora"></div>
      <div class="pcard-body">
        <div class="p-eye">Plancha Rizadora</div>
        <h3>Plancha Rizadora</h3>
        <div class="by">Recomendada por Javier Velásquez</div>
        <p>Ondas suaves, definidas y duraderas, con iones negativos, placas de cerámica y borde Soft Edge.</p>
        <div class="p-feats"><span>Iones negativos</span><span>Cerámica</span><span>Soft Edge</span></div>
        <a href="{{ section.settings.plancha_url }}" class="btn">Ver Plancha Rizadora <span>&rarr;</span></a>
      </div>
    </article>

  </div>
</section>

<section id="javier" class="creator">
  <div class="c-photo"><img src="{{ 'DSC04531.jpg' | file_url }}" alt="Javier Velásquez"></div>
  <div class="c-text">
    <div class="c-eye">El estilista detrás</div>
    <h2>Cada herramienta lleva el <b>respaldo de Javier</b>.</h2>
    <p>Como estilista profesional con años de experiencia y miles de clientas, Javier Velásquez selecciona y recomienda solo las herramientas que cumplen los estándares que busca para el cabello de sus clientas.</p>
    <p>La tienda crece con cada herramienta que decide respaldar.</p>
  </div>
</section>

<footer>
  <div class="foot-in">
    <div class="fl"><div class="n">JAVIER VELÁSQUEZ</div><div class="s">Store</div></div>
    <div class="fr">© 2026 Javier Velásquez Store. Todos los derechos reservados.</div>
  </div>
</footer>
</div>

<script>
(function(){
  var root = document.currentScript.closest('.jv-store') || document.querySelector('.jv-store');
  if(!root) return;
  root.classList.add('anim-on');
  var imgs = root.querySelectorAll('img');
  for (var i=0;i<imgs.length;i++){ (function(img){
    img.classList.add('lz');
    if(img.complete && img.naturalWidth>0){ img.classList.add('loaded'); }
    else { img.addEventListener('load',function(){img.classList.add('loaded');});
           img.addEventListener('error',function(){img.classList.add('loaded');}); }
  })(imgs[i]); }
  var secs = root.querySelectorAll('section');
  if('IntersectionObserver' in window){
    for (var j=0;j<secs.length;j++) secs[j].classList.add('reveal');
    var io=new IntersectionObserver(function(ent){ent.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }});},
      {threshold:0.12, rootMargin:'0px 0px -8% 0px'});
    for (var k=0;k<secs.length;k++) io.observe(secs[k]);
  }
})();
</script>

{% schema %}
{
  "name": "Home Tienda JV",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Enlaces de navegacion" },
    { "type": "text", "id": "home_url",       "label": "Inicio de la tienda",  "default": "/" },
    { "type": "text", "id": "plancha_url",    "label": "Pagina Plancha Rizadora", "default": "/pages/plancha-rizadora" },
    { "type": "text", "id": "plasmaflow_url", "label": "Pagina PLASMAFLOW",     "default": "/pages/plasmaflow" }
  ],
  "presets": [ { "name": "Home Tienda JV", "category": "Javier Velasquez Store" } ]
}
{% endschema %}